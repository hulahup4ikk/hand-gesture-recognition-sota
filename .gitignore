# Heavy datasets and archives (tracked structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/public_sample/*
!data/public_sample/.gitkeep
data/split/*
!data/split/.gitkeep
*.zip
*.tar
*.tar.gz
*.rar

# Model checkpoints and weights (tracked structure via .gitkeep)
weights/*
!weights/.gitkeep
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors
*.bin
*.h5

# Streamlit runtime / cache
.streamlit/
